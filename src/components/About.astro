---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import iceland from '../assets/iceland.jpg';
import newYork from '../assets/new-york.webp';
import oman from '../assets/oman.webp';
import { about, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="about" index="06" title={about.title[lang]} intro={about.intro[lang]}>
  <div class="about reveal">
    <div class="about-text">
      {about.paragraphs.map((p) => <p set:html={p[lang]} />)}
      <div class="interests">
        <h3 class="mono">{about.interestsTitle[lang]}</h3>
        <ul class="tags tags-lg" role="list">
          {about.interests.map((interest) => <li>{interest[lang]}</li>)}
        </ul>
      </div>
    </div>
    <div class="about-gallery">
      <figure>
        <Image class="about-photo" src={iceland} alt={about.imageAlt[lang]} widths={[400, 800]} sizes="(min-width: 700px) 300px, 70vw" />
        <figcaption class="mono">{about.travel.iceland[lang]}</figcaption>
      </figure>
      <div class="about-travel">
        <figure>
          <Image src={newYork} alt={about.travel.newYorkAlt[lang]} widths={[200, 400]} sizes="(min-width: 700px) 135px, 35vw" />
          <figcaption class="mono">New York</figcaption>
        </figure>
        <figure>
          <Image src={oman} alt={about.travel.omanAlt[lang]} widths={[200, 400]} sizes="(min-width: 700px) 135px, 35vw" />
          <figcaption class="mono">Oman</figcaption>
        </figure>
      </div>
    </div>
  </div>
</Section>
