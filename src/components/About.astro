---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import iceland from '../assets/iceland.jpg';
import { about, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="about" index="06" title={about.title[lang]} intro={about.intro[lang]}>
  <div class="about reveal">
    <div class="about-text">
      {about.paragraphs.map((p) => <p set:html={p[lang]} />)}
      <div class="interests">
        <h3 class="mono">{about.interestsTitle[lang]}</h3>
        <ul class="tags tags-lg" role="list">
          {about.interests.map((interest) => <li>{interest[lang]}</li>)}
        </ul>
      </div>
    </div>
    <Image class="about-photo" src={iceland} alt={about.imageAlt[lang]} widths={[400, 800]} sizes="(min-width: 700px) 300px, 70vw" />
  </div>
</Section>
