---
import { contact, site, links, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = contact.form;
const profiles = [
  { label: 'LinkedIn', value: 'Ömer Ayar', href: links.linkedin },
  { label: 'Xing', value: 'Ömer Ayar', href: links.xing },
  { label: 'GitHub', value: 'OeMA4', href: links.github },
  { label: 'Freelance.de', value: contact.profile[lang], href: links.freelance },
];
---

<section id="contact" class="section contact-section" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-panel reveal">
      <div class="contact-intro">
        <span class="section-index mono">07 — {contact.title[lang]}</span>
        <h2 id="contact-title">{contact.headline[lang]}</h2>
        <p>{contact.text[lang]}</p>

        <h3 class="mono">{contact.direct[lang]}</h3>
        <ul class="contact-links" role="list">
          <li>
            <a data-mail-user={site.emailUser} data-mail-domain={site.emailDomain}>
              <span class="mono">E-Mail</span>
              <span data-mail-label>{site.emailUser}(at){site.emailDomain}</span>
            </a>
          </li>
          {
            profiles.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener noreferrer">
                  <span class="mono">{p.label}</span>
                  <span>
                    {p.value}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="contact-form"
        action={`https://formspree.io/f/${site.formspreeId}`}
        method="POST"
        data-contact-form
        data-sending={f.sending[lang]}
        data-success={f.success[lang]}
        data-error={f.error[lang]}
      >
        <div class="field-row">
          <label class="field">
            <span>{f.name[lang]}</span>
            <input type="text" name="name" autocomplete="name" required placeholder={f.namePh[lang]} />
          </label>
          <label class="field">
            <span>{f.email[lang]}</span>
            <input type="email" name="email" autocomplete="email" required placeholder={f.emailPh[lang]} />
          </label>
        </div>
        <label class="field">
          <span>{f.subject[lang]}</span>
          <input type="text" name="subject" required placeholder={f.subjectPh[lang]} />
        </label>
        <label class="field">
          <span>{f.message[lang]}</span>
          <textarea name="message" rows="6" required placeholder={f.messagePh[lang]}></textarea>
        </label>
        <!-- Honeypot gegen Spam-Bots (Formspree wertet _gotcha aus) -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
        <div class="form-footer">
          <button type="submit" class="btn btn-primary">
            <span data-label>{f.submit[lang]}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
