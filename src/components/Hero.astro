---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { hero, facts, site, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-text">
      {
        site.available && (
          <p class="status">
            <span class="status-dot" aria-hidden="true" />
            {hero.available[lang]}
          </p>
        )
      }
      <p class="eyebrow mono">{hero.eyebrow[lang]}</p>
      <h1>{site.name}</h1>
      <p class="hero-role">{site.role}</p>
      <p class="hero-description" set:html={hero.description[lang]} />
      <div class="hero-cta">
        <a href="#contact" class="btn btn-primary">
          {hero.ctaPrimary[lang]}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="#projects" class="btn btn-ghost">{hero.ctaSecondary[lang]}</a>
      </div>
    </div>

    <figure class="hero-photo">
      <Image
        src={portrait}
        alt={hero.photoAlt[lang]}
        widths={[800, 1200, 1536]}
        sizes="(min-width: 900px) 800px, 140vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="mono">{hero.photoCaption[lang]}</figcaption>
    </figure>
  </div>

  <div class="container">
    <dl class="facts">
      {
        facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label[lang]}</dt>
            <dd>{fact.value[lang]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
