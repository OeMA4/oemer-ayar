---
interface Props {
  id: string;
  index: string;
  title: string;
  intro?: string;
}

const { id, index, title, intro } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container section-grid">
    <header class="section-head reveal">
      <span class="section-index mono">{index}</span>
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p class="section-intro">{intro}</p>}
    </header>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>
